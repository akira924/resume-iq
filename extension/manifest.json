{
  "manifest_version": 3,
  "name": "ResumeIQ",
  "version": "0.1.0",
  "description": "ResumeIQ in the browser side panel.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open ResumeIQ"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content/chatgpt.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["sidePanel", "cookies", "clipboardRead"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": ["http://localhost/*", "https://resume-iq-qfog.vercel.app/*"]
}
